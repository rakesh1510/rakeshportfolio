  <div id="footerMount"></div>

  <!-- Load i18n first, then app.js once -->
  <script src="assets/i18n.js"></script>
  <script src="assets/app.js"></script>
  <script>
    (function(){
      fetch('assets/footer.html', {cache:'no-store'})
        .then(r=>r.text())
        .then(html=>{
          const m = document.getElementById('footerMount');
          if(m){ m.innerHTML = html; }
          if(window.__setLang){
            const saved = localStorage.getItem('site_lang') || 'en';
            window.__setLang(saved);
          }
        })
        .catch(()=>{});
    })();
  </script>
